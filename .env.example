# ---------------------------------------------------------------------------
# Classroom OS environment template
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Database (libsql). Local SQLite file by default.
DATABASE_URL=file:local.db
# Only required when pointing at a remote Turso DB (e.g. production).
DATABASE_AUTH_TOKEN=

# Session token signing secret (HMAC-SHA256). Generate one with:
#   openssl rand -hex 32
# Required in production; a hardcoded dev fallback is used otherwise.
SESSION_SECRET=
# Legacy alias accepted as fallback if SESSION_SECRET is unset.
AUTH_SECRET=

# --- DEV-ONLY demo fixtures (never set these in production) -----------------
# Overrides the authenticated role for local demos (ADMIN|TEACHER|CR|STUDENT).
APP_ROLE=
# Pins the student identity used by demo logins/role switching.
DEMO_STUDENT_ID=

# UploadThing file uploads (https://uploadthing.com/dashboard).
UPLOADTHING_TOKEN=

# Deliberate override to let db:seed target a remote database (DANGEROUS)
SEED_ALLOW_REMOTE="0"

